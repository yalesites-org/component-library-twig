{
  "name": "@yalesites-org/web-components",
  "version": "0.1.0",
  "description": "Framework-neutral Web Component distribution of YaleSites design-system components (Lit + Shadow DOM + CSS custom property tokens). Epic #1351, Wave 10.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yalesites-org/component-library-twig.git",
    "directory": "web-components"
  },
  "keywords": [
    "yalesites",
    "web-components",
    "custom-elements",
    "lit",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.js",
    "./src/yds-divider.js",
    "./src/yds-accordion.js",
    "./dist/*"
  ],
  "main": "dist/yalesites-web-components.js",
  "module": "dist/yalesites-web-components.js",
  "exports": {
    ".": "./dist/yalesites-web-components.js",
    "./divider": "./dist/yds-divider.js",
    "./accordion": "./dist/yds-accordion.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check src/yds-divider.js && node --check src/yds-accordion.js && node --check src/index.js",
    "test": "vitest run",
    "prepack": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
}
