export default "{# Get versioned icons.svg filename from manifest if available. #}\n{% set icons_svg_filename = getAssetPath('icons.svg', 'themes/contrib/atomic') ?: 'icons.svg' %}\n\n<div data-main-menu-state=\"loaded\" data-component-width=\"site\" data-site-header-nav-position=\"left\" data-site-header-border-thickness=\"8\" data-header-theme={{ site_header__theme }} data-header-accent=\"three\" class=\"site-header\">\n  <div class=\"site-header__inner\">\n    <div class=\"site-header__menu-wrapper\">\n      <div class=\"site-header__menu-secondary site-header__menu-secondary--desktop\">\n        <div class=\"site-header__secondary\">\n          <div class=\"site-header__utility-nav\">\n            <div class=\"utility-bar\">\n              {# Navigation #}\n              <nav class=\"utility-nav\" aria-label=\"Utility {{ site_header__theme }}\" data-menu-variation=\"basic\">\n                <ul class=\"utility-nav__menu utility-nav__menu--level-0\">\n                  <li class=\"utility-nav__item utility-nav__item--level-0\">\n                    <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav__link utility-nav__link--level-0\" href=\"#\">News</a>\n                  </li>\n                  <li class=\"utility-nav__item utility-nav__item--level-0\">\n                    <a data-link-style=\"underline-with-icon\" data-link-type=\"external\" class=\"utility-nav__link utility-nav__link--level-0 utility-nav__link--with-icon link-purpose link-purpose-external\" href=\"#\">\n                      <span class=\"link-purpose-nobreak\">Workday<span class=\"link-purpose-icon link-purpose-external-icon fa-icon fa-solid fa-arrow-up-right fa-fw\" aria-hidden=\"true\" title=\"Link is external\"></span>\n                        <span class=\"link-purpose-text\">(Link is external)</span>\n                      </span>\n                    </a>\n                  </li>\n                  <li class=\"utility-nav__item utility-nav__item--level-0\">\n                    <a data-link-style=\"underline-with-icon\" data-link-type=\"external\" class=\"utility-nav__link utility-nav__link--level-0 utility-nav__link--with-icon link-purpose link-purpose-external\" href=\"#\">\n                      Yale Status\n                      <span class=\"link-purpose-spacer\"></span>\n                      <span class=\"link-purpose-nobreak\">Board<span class=\"link-purpose-icon link-purpose-external-icon fa-icon fa-solid fa-arrow-up-right fa-fw\" aria-hidden=\"true\" title=\"Link is external\"></span>\n                        <span class=\"link-purpose-text\">(Link is external)</span>\n                      </span>\n                    </a>\n                  </li>\n                  <li class=\"utility-nav__item utility-nav__item--level-0\">\n                    <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav__link utility-nav__link--level-0\" href=\"#\">Get Help</a>\n                  </li>\n                </ul>\n              </nav>\n              {# Dropdown #}\n              <div class=\"utility-nav__dropdown\" aria-haspopup=\"true\">\n                <button data-cta-hover-style=\"fade\" data-cta-radius=\"pill\" data-cta-style=\"filled\" data-cta-outline-weight=\"2\" data-cta-control-type=\"dropdown\" data-cta-theme=\"none\" class=\"utility-nav__cta\">About Operations\n                  <svg class=\"cta__icon\">\n                    <use xlink:href=\"{{ icons_svg_filename }}#angle-down\"></use>\n                  </svg>\n                </button>\n                <div class=\"utility-nav__dropdown-content\" aria-hidden=\"true\">\n                  <nav class=\"utility-nav-dropdown\" aria-label=\"Utility Dropdown\" data-menu-variation=\"mega\">\n                    <ul class=\"utility-nav-dropdown__menu utility-nav-dropdown__menu--level-0\">\n                      <li class=\"utility-nav-dropdown__item utility-nav-dropdown__item--level-0\">\n                        <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav-dropdown__link utility-nav-dropdown__link--level-0\" href=\"#\">\n                          Our Strategy &amp; Initiatives\n                        </a>\n                      </li>\n                      <li class=\"utility-nav-dropdown__item utility-nav-dropdown__item--level-0\">\n                        <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav-dropdown__link utility-nav-dropdown__link--level-0\" href=\"#\">\n                          Business Operations\n                        </a>\n                      </li>\n                      <li class=\"utility-nav-dropdown__item utility-nav-dropdown__item--level-0\">\n                        <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav-dropdown__link utility-nav-dropdown__link--level-0\" href=\"#\">\n                          Administrative Operations\n                        </a>\n                      </li>\n                      <li class=\"utility-nav-dropdown__item utility-nav-dropdown__item--level-0\">\n                        <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav-dropdown__link utility-nav-dropdown__link--level-0\" href=\"#\">\n                          Facilities\n                        </a>\n                      </li>\n                      <li class=\"utility-nav-dropdown__item utility-nav-dropdown__item--level-0\">\n                        <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav-dropdown__link utility-nav-dropdown__link--level-0\" href=\"#\">\n                          Finance\n                        </a>\n                      </li>\n                      <li class=\"utility-nav-dropdown__item utility-nav-dropdown__item--level-0\">\n                        <a data-link-style=\"underline\" data-link-type=\"internal\" class=\"utility-nav-dropdown__link utility-nav-dropdown__link--level-0\"