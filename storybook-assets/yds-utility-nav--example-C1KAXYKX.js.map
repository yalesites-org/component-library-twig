<label for=\"edit-keywords--header-search-form-desktop\">\n                      <svg class=\"utility-nav__icon utility-nav__icon--search\" aria-hidden=\"true\" role=\"img\">\n                        <use xlink:href=\"{{ icons_svg_filename }}#magnifying-glass\"></use>\n                      </svg>\n                      <span class=\"visually-hidden\">Search</span>\n                    </label>\n                    <input placeholder=\"Search this site\" type=\"text\" name=\"keywords\" value=\"\" size=\"30\" maxlength=\"128\" class=\"form-text\">\n                  </div>\n                  <div class=\"form-actions form-wrapper\">\n                    <input class=\"visually-hidden button form-submit\" type=\"submit\" value=\"Search\">\n                  </div>\n                </form>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n"