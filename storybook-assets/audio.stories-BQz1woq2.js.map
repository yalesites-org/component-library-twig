# audio-props.yml
#
# Audio Player component property definitions.
# This file is the single source of truth for both Storybook controls
# and MDX documentation tables.

content:
  twigProp: audio_embed__content
  name: Content
  type: string
  required: false
  description: >
    Optional text shown above the player, such as a short label or
    description of the audio file.
  control: text

url:
  twigProp: audio_embed__url
  name: Audio URL
  type: string
  required: true
  description: >
    URL of the audio file used by the default player source. In Drupal the
    source is supplied by the block's media field instead of this value.
  control: text

transcript:
  twigProp: audio_embed__transcript
  name: Transcript
  type: string
  required: false
  description: >
    Optional transcript of the audio, as rich text. It renders below the
    player as page text, styled like the Video description, under a
    "Transcript" button that shows and hides it, so people who cannot hear
    the audio can still get its content without playing it. In Drupal it
    comes from the Audio block's Transcription field.
  control: text
