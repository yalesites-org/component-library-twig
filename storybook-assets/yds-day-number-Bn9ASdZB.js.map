export default "{#\n # Day number: the date inside one calendar day.\n #\n # Available Variables:\n # - day_number__number: the date shown, e.g. 28.\n # - day_number__label: full accessible date, e.g. \"Wednesday, October 28, 4 events\".\n #   Rendered as visually hidden text; the visible number is hidden from screen readers.\n # - day_number__size: 32 (Full month grid) or 36 (Compact and phone). Default 36.\n # - day_number__has_events: bold number. Default false.\n # - day_number__today: Yale Blue square, white bold number. Default false.\n # - day_number__selected: Blue Soft fill, Medium Blue ring. Default false.\n # - day_number__past: gray number. Default false.\n # - day_number__other_month: Gray 100 fill, gray number. Default false.\n #\n # The parent sets outer margin and width; this atom never does.\n #}\n\n{% set day_number__base_class = 'day-number' %}\n{% set day_number__size = day_number__size|default('36') %}\n{% if day_number__size != '32' %}\n  {% set day_number__size = '36' %}\n{% endif %}\n\n{% set day_number__attributes = {\n  'class': bem(day_number__base_class),\n  'data-day-number-size': day_number__size,\n} %}\n{% if day_number__has_events %}\n  {% set day_number__attributes = day_number__attributes|merge({'data-day-number-has-events': 'true'}) %}\n{% endif %}\n{% if day_number__today %}\n  {% set day_number__attributes = day_number__attributes|merge({'data-day-number-today': 'true'}) %}\n{% endif %}\n{% if day_number__selected %}\n  {% set day_number__attributes = day_number__attributes|merge({'data-day-number-selected': 'true'}) %}\n{% endif %}\n{% if day_number__past %}\n  {% set day_number__attributes = day_number__attributes|merge({'data-day-number-past': 'true'}) %}\n{% endif %}\n{% if day_number__other_month %}\n  {% set day_number__attributes = day_number__attributes|merge({'data-day-number-other-month': 'true'}) %}\n{% endif %}\n\n<span {{ add_attributes(day_number__attributes) }}>\n  {% if day_number__label %}\n    <span {{ bem('label', [], day_number__base_class) }}>{{ day_number__label }}</span>\n  {% endif %}\n  <span {{ bem('number', [], day_number__base_class) }}{% if day_number__label %} aria-hidden=\"true\"{% endif %}>{{ day_number__number|default('1') }}</span>\n</span>\n"