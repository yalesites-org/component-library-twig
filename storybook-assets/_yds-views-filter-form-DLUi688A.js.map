export default "{#\n  Static copy of a Views filter form after Drupal's Chosen library has run, for\n  the visual regression stories. Chosen is a Drupal library and is not loaded\n  in Storybook, so this reproduces its output rather than running it. It also\n  reproduces what yds-select.js adds, open or closed: chips that do not fit\n  on the one-line row get .ys-search-choice--overflow, and a\n  <li class=\"ys-select-more\"> \"+N more\" badge goes before li.search-field.\n\n  - calendar: render the Events calendar wrapper (form#event-calendar-filter-form).\n  - search: placeholder for the Search field.\n  - fields: list of { id, label, options, selected, open, visible }.\n    visible: how many leading chips fit on the closed row (default: all, so no\n    badge). The rest are hidden and counted in the \"+N more\" badge.\n#}\n{% set filter_classes = 'views-exposed-form ys-filter-form ys-filter-form--scaffold' %}\n{% if calendar %}\n<form class=\"event-calendar-filter-form\" id=\"event-calendar-filter-form\">\n  <div class=\"{{ filter_classes }}\">\n{% else %}\n<form class=\"{{ filter_classes }}\">\n{% endif %}\n  <div class=\"form-item form-item-search\">\n    <label class=\"form-item__label\" for=\"{{ id }}-search\">Search</label>\n    <input class=\"form-text form-item__textfield\" type=\"text\" id=\"{{ id }}-search\" placeholder=\"{{ search }}\">\n  </div>\n  {% for field in fields %}\n    {% set count = field.selected|length %}\n    {% set visible = field.visible ?? count %}\n    {% set hidden = field.selected|slice(visible) %}\n    <div class=\"form-item form-item-select\">\n      <label class=\"form-item__label\" for=\"{{ id }}-{{ field.id }}\">{{ field.label }}</label>\n      <div class=\"form-item__dropdown\">\n        <select multiple id=\"{{ id }}-{{ field.id }}\" class=\"form-select chosen-enable form-item__select\" tabindex=\"-1\" style=\"position: absolute; width: 0; height: 0; clip: rect(0, 0, 0, 0);\">\n          {% for option in field.options %}\n            <option{% if option in field.selected %} selected{% endif %}>{{ option }}</option>\n          {% endfor %}\n        </select>\n        <div class=\"chosen-container chosen-container-multi form-select chosen-enable form-item__select{% if field.open %} chosen-with-drop chosen-container-active{% endif %}\" style=\"width: 100%;\">\n          <ul class=\"chosen-choices\">\n            {% set index = 0 %}\n            {% for option in field.options %}\n              {% if option in field.selected %}\n                <li class=\"search-choice{% if index >= visible %} ys-search-choice--overflow{% endif %}\"><span>{{ option }}</span><button type=\"button\" tabindex=\"-1\" class=\"search-choice-close\"></button></li>\n                {% set index = index + 1 %}\n              {% endif %}\n            {% endfor %}\n            {% if hidden|length %}\n              <li class=\"ys-select-more\" aria-label=\"+{{ hidden|length }} more selected: {{ hidden|join(', ') }}\">+{{ hidden|length }} more</li>\n            {% endif %}\n            <li class=\"search-field\">\n              <input class=\"chosen-search-input{% if not count %} default{% endif %}\" type=\"text\" autocomplete=\"off\" placeholder=\"{% if not count %}Choose some options{% endif %}\" style=\"width: {{ count ? 25 : 211 }}px;\">\n            </li>\n          </ul>\n          <div class=\"chosen-drop\">\n            <ul class=\"chosen-results\">\n              {# No highlighted row: a mouse open highlights none, only the keyboard does (#1930). #}\n              {% if field.open %}\n                {% for option in field.options %}\n                  {% if option in field.selected %}\n                    <li class=\"result-selected\">{{ option }}</li>\n                  {% else %}\n                    <li class=\"active-result\">{{ option }}</li>\n                  {% endif %}\n                {% endfor %}\n              {% endif %}\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  {% endfor %}\n  <div class=\"form-actions\">\n    <input data-cta-theme=\"one\" data-cta-radius=\"none\" data-cta-style=\"filled\" data-cta-outline-weight=\"2\" data-cta-hover-style=\"fade\" class=\"cta button form-submit form-item__textfield\" type=\"submit\" value=\"Apply\">\n  </div>\n{% if calendar %}\n  </div>\n</form>\n{% else %}\n</form>\n{% endif %}\n"