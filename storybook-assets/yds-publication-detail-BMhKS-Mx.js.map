export default "{#\n # Publication Detail meta block\n #\n # Heavy meta header used at the top of a Resource (publication) full page.\n # Mirrors the structure of @molecules/meta/event-meta/yds-event-meta-localist:\n # a page-title shell with an overline + meta region that contains a\n # `details-wrapper` grid of fields.\n #\n # Available Variables:\n # - publication_detail__heading                 (string)  Title.\n # - publication_detail__category                (string)  Category overline.\n # - publication_detail__publish_date            (string)  Pre-formatted date.\n # - publication_detail__authors                 (array)   [{ label, url }]\n # - publication_detail__journal_publication_name  (string)\n # - publication_detail__journal_publication_issue (string)\n # - publication_detail__citation                (string)  Rendered HTML.\n # - publication_detail__description             (string)  Rendered HTML.\n # - publication_detail__abstract                (string)  Rendered HTML.\n # - publication_detail__external_source         (object)  { url, title }\n # - publication_detail__download_url            (string)\n # - publication_detail__download_label          (string)\n # - publication_detail__download_aria_label     (string)\n # - publication_detail__resource_type           (string)  Media bundle.\n # - publication_detail__media_id                (int)     For video embed.\n # - publication_detail__document_image          (render)  Thumbnail render array.\n # - publication_detail__metadata                (array)   Keyed taxonomy data:\n #     { field_name: { label: 'Audience', items: [{ '#title', '#url' }, ...] } }\n #}\n\n{% set publication_detail__base_class = 'publication-detail' %}\n\n{% set publication_detail__attributes = {\n  'data-component-width': publication_detail__width|default('site'),\n  class: bem(publication_detail__base_class, [], publication_detail__blockname),\n} %}\n\n{# Anything to show in the grid? #}\n{% set has_grid =\n  publication_detail__authors|length\n  or publication_detail__publish_date\n  or publication_detail__external_source.url\n  or publication_detail__download_url\n  or publication_detail__journal_publication_name\n  or publication_detail__journal_publication_issue\n  or publication_detail__citation\n  or publication_detail__metadata|length\n%}\n\n<div {{ add_attributes(publication_detail__attributes) }} data-embedded-components>\n  {% embed \"@molecules/page-title/yds-page-title.twig\" with {\n    page_title__heading: publication_detail__heading,\n    page_title__blockname: publication_detail__base_class,\n    page_title__variation: 'event',\n  } %}\n\n    {% block page_title__overline %}\n      {% if publication_detail__category %}\n        {% include \"@atoms/typography/text/yds-text.twig\" with {\n          text__blockname: publication_detail__base_class,\n          text__content: publication_detail__category,\n          text__base_class: 'category',\n        } %}\n      {% endif %}\n    {% endblock %}\n\n    {% block page_title__image %}\n      {% if publication_detail__document_image or publication_detail__download_url %}\n        <div {{ bem('image-wrap', [], publication_detail__base_class) }}>\n          {% if publication_detail__document_image %}\n            <div {{ bem('image', [], publication_detail__base_class) }}>\n              {# `|raw` matches the pattern used by yds-video-embed and\n                 yds-image — the variable comes through as already-rendered\n                 HTML (a Drupal render array result, or a pre-built img/svg\n                 string in Storybook fixtures). Without it, autoescape\n                 prints the markup as text. #}\n              {{ publication_detail__document_image|raw }}\n            </div>\n          {% endif %}\n          {% if publication_detail__download_url %}\n            <div {{ bem('download', [], publication_detail__base_class) }}>\n              {% include \"@atoms/controls/cta/yds-cta.twig\" with {\n                cta__content: publication_detail__download_label|default('Download'),\n                cta__href: publication_detail__download_url,\n                cta__component_theme: 'one',\n                cta__attributes: {\n                  'aria-label': publication_detail__download_aria_label,\n                  'download': '',\n                  'data-link-type': 'download',\n                },\n              } %}\n            </div>\n          {% endif %}\n        </div>\n      {% endif %}\n    {% endblock %}\n\n    {% block page_title__meta %}\n      <div {{ bem('inner', [], publication_detail__base_class) }}>\n\n        {% if publication_detail__resource_type == 'video' and publication_detail__media_id %}\n          <div {{ bem('video', [], publication_detail__base_class) }}>\n            {# Same `|raw` rationale as above — the iframe HTML is built\n               upstream (atomic's media-oembed-content.html.twig override\n               in Drupal, or a fixture string in Storybook). #}\n            {{ video_embed__content__1|raw }}\n          </div>\n        {% endif %}\n\n        {#\n          Each metadata cell is rendered as <dl><dt><dd> for proper\n          term-definition semantics (WCAG 1.3.1 / 2.4.6). Wrapping each\n          cell in its own dl preserves the existing flex grid: the\n          details-wrapper still has one child per cell, so the 3-up\n          column layout and vertical-separator math are unchanged.\n        #}\n        {% if has_grid %}\n          <div {{ bem('details-wrapper', [], publication_detail__base_class) }}>\n\n            {% if publication_detail__authors|length %}\n              <dl {{ bem('authors', [], publication_detail__base_class) }}>\n                <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n                  {{ publication_detail__authors|length > 1 ? 'Authors' : 'Author' }}\n                </dt>\n                <dd>\n                  <ul {{ bem('authors-list', [], publication_detail__base_class) }}>\n                    {% for author in publication_detail__authors %}\n                      <li {{ bem('authors-list__item', [], publication_detail__base_class) }}>\n                        {% if author.url %}\n                          <a href=\"{{ author.url }}\">{{ author.label }}</a>\n                        {% else %}\n                          {{ author.label }}\n                        {% endif %}\n                      </li>\n                    {% endfor %}\n                  </ul>\n                </dd>\n              </dl>\n            {% endif %}\n\n            {% if publication_detail__publish_date %}\n              <dl {{ bem('publish-date', [], publication_detail__base_class) }}>\n                <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n                  Published\n                </dt>\n                <dd {{ bem('publish-date__value', [], publication_detail__base_class) }}>\n                  {{ publication_detail__publish_date }}\n                </dd>\n              </dl>\n            {% endif %}\n\n            {% if publication_detail__journal_publication_name %}\n              <dl {{ bem('journal-name', [], publication_detail__base_class) }}>\n                <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n                  Publication\n                </dt>\n                <dd {{ bem('journal-name__value', [], publication_detail__base_class) }}>\n                  {{ publication_detail__journal_publication_name }}\n                </dd>\n              </dl>\n            {% endif %}\n\n            {% if publication_detail__journal_publication_issue %}\n              <dl {{ bem('journal-issue', [], publication_detail__base_class) }}>\n                <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n                  Issue\n                </dt>\n                <dd {{ bem('journal-issue__value', [], publication_detail__base_class) }}>\n                  {{ publication_detail__journal_publication_issue }}\n                </dd>\n              </dl>\n            {% endif %}\n\n            {% if publication_detail__external_source.url %}\n              <dl {{ bem('external-source', [], publication_detail__base_class) }}>\n                <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n                  External Source\n                </dt>\n                <dd {{ bem('external-source__link', [], publication_detail__base_class) }}>\n                  {% include \"@atoms/controls/cta/yds-cta.twig\" with {\n                    cta__content: publication_detail__external_source.title|default('Visit Source'),\n                    cta__href: publication_detail__external_source.url,\n                    cta__component_theme: 'one',\n                    cta__style: 'outline',\n                  } %}\n                </dd>\n              </dl>\n            {% endif %}\n\n            {# Generic taxonomy cells from metadata array #}\n            {% for field_name, group in publication_detail__metadata %}\n              {% if group.items|length %}\n                <dl {{ bem('taxonomy', [field_name|replace({'field_': ''})|replace({'_': '-'})], publication_detail__base_class) }}>\n                  <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n                    {{ group.label }}\n                  </dt>\n                  <dd>\n                    <ul {{ bem('taxonomy-list', [], publication_detail__base_class) }}>\n                      {% for item in group.items %}\n                        <li {{ bem('taxonomy-list__item', [], publication_detail__base_class) }}>\n                          {{ item }}\n                        </li>\n                      {% endfor %}\n                    </ul>\n                  </dd>\n                </dl>\n              {% endif %}\n            {% endfor %}\n\n            {% if publication_detail__citation %}\n              <dl {{ bem('citation', [], publication_detail__base_class) }}>\n                <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n                  Citation\n                </dt>\n                <dd>\n                  {% include '@atoms/controls/text-copy-button/yds-text-copy-button.twig' with {\n                    text_copy_button__pre_text: publication_detail__citation,\n                    text_copy_button__pre_text_tag: 'div',\n                    text_copy_button__content: 'Copy citation',\n                  } %}\n                </dd>\n              </dl>\n            {% endif %}\n\n          </div>\n        {% endif %}\n\n        {% if publication_detail__abstract %}\n          <dl {{ bem('abstract', [], publication_detail__base_class) }}>\n            <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n              Abstract\n            </dt>\n            <dd {{ bem('abstract__value', [], publication_detail__base_class) }}>\n              {{ publication_detail__abstract }}\n            </dd>\n          </dl>\n        {% endif %}\n\n        {% if publication_detail__description %}\n          <dl {{ bem('description', [], publication_detail__base_class) }}>\n            <dt {{ bem('field__label', [], publication_detail__base_class) }}>\n              Description\n            </dt>\n            <dd {{ bem('description__value', [], publication_detail__base_class) }}>\n              {{ publication_detail__description }}\n            </dd>\n          </dl>\n        {% endif %}\n\n      </div>\n    {% endblock %}\n  {% endembed %}\n</div>\n"