# Facts and Figures Icon Configuration
#
# This file defines all available icons for Facts and Figures components.
# This is the SINGLE SOURCE OF TRUTH for icon options.
#
# Used by:
# - Storybook (for interactive controls)
# - Drupal (via FactsAndFiguresIconManager service)
# - Any other consumers of the Facts and Figures component
#
# To add new icons:
# 1. Add the icon SVG file to images/icons/ directory
# 2. Add the icon definition below in the appropriate category
# 3. Rebuild component library: npm run build
# 4. Clear Drupal cache: drush cr

# Configuration metadata
config:
  version: '1.1'
  default_value: '_none'
  none_label: '- None -'
  description: 'Available icons for Facts and Figures components'

# Available icons (alphabetically sorted)
icons:
  atom-solid: 'Atom'
  bee: 'Bee'
  bolt: 'Bolt'
  book-solid: 'Book'
  calendar-solid: 'Calendar'
  car-building: 'Car Building'
  chart-line-solid: 'Chart Line'
  city: 'City'
  cloud-rain-solid: 'Cloud with Rain'
  code-solid: 'Code'
  dollar-sign-solid: 'Dollar Sign'
  droplet: 'Droplet'
  envelope-solid: 'Envelope'
  circle-exclamation: 'Exclamation Circle'
  flask-solid: 'Flask'
  face-frown-solid: 'Frowning Face'
  gears: 'Gears'
  globe-solid: 'Globe'
  graduation-cap-solid: 'Graduation Cap'
  hand-holding-dollar-solid: 'Hand Holding Dollar'
  house-chimney: 'House Chimney'
  industry-windows: 'Industry Windows'
  circle-info: 'Information Circle'
  leaf-solid: 'Leaf'
  lightbulb-solid: 'Lightbulb'
  location-dot-solid: 'Location Dot'
  mountain-sun-solid: 'Mountain with Sun'
  pencil-solid: 'Pencil'
  people-group-solid: 'People'
  piggy-bank-solid: 'Piggy Bank'
  recycle-solid: 'Recycle'
  rocket-launch: 'Rocket Launch'
  face-smile-solid: 'Smiling Face'
  sun: 'Sun'
  chalkboard-user-solid: 'Teacher'
  temperature-sun: 'Temperature Sun'
  tree-solid: 'Tree'
  university-solid: 'University'
  user-solid: 'User'
  wave-pulse: 'Wave Pulse'

# Cache configuration (for Drupal consumers)
cache:
  tags:
    - 'component_library_icons'
    - 'facts_and_figures_icons'
  max_age: 3600 # 1 hour
