export default "{% set type__base_class = 'cl-type' %}\n\n<ul {{ bem(type__base_class) }}>\n  {% for family in families %}\n    <li {{ bem('family', [], type__base_class) }}>\n      {% for style in family.styles %}\n        <div {{ bem('sample', [], type__base_class) }} style=\"font-size: var(--font-scale-33-48); font-family: {{ family.id }}; font-weight: {{ style.weight }}; font-style: {{ style.style }}\">\n          {{ family.name }}\n          -\n          {{ style.name }}\n        </div>\n      {% endfor %}\n    </li>\n  {% endfor %}\n</ul>\n"