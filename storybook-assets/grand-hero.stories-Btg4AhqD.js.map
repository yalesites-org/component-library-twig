# grand-hero-props.yml
#
# Grand Hero Banner component property definitions.
# This file is the single source of truth for both Storybook controls
# and MDX documentation tables.

heading:
  twigProp: grand_hero__heading
  name: Heading
  type: string
  required: true
  description: The main heading text for the grand hero banner
  control: text

snippet:
  twigProp: grand_hero__snippet
  name: Snippet
  type: string
  required: false
  description: Additional descriptive text (supports HTML)
  control: text

linkContent:
  twigProp: grand_hero__link__content
  name: Link Content
  type: string
  required: false
  description: Text for the primary call-to-action button
  control: text

linkContentTwo:
  twigProp: grand_hero__link__content_two
  name: Link Content Two
  type: string
  required: false
  description: Text for the secondary call-to-action button
  control: text

bgColor:
  twigProp: grand_hero__content__background
  name: Component Theme (dial)
  type: select
  required: false
  description: Component theme color
  default: one
  options:
    - one
    - two
    - three
    - four
    - five
    - six
  control: select
  labels:
    one: 'One'
    two: 'Two'
    three: 'Three'
    four: 'Four'
    five: 'Five'
    six: 'Six'

overlayVariation:
  twigProp: grand_hero__overlay_variation
  name: Overlay Position
  type: select
  required: false
  description: 'Content overlay style: full, contained, or contained-narrow'
  default: contained
  options:
    - full
    - contained
    - contained-narrow
  control: select
  labels:
    full: 'Full'
    contained: 'Floating Box'
    contained-narrow: 'Floating Box Narrow'

size:
  twigProp: grand_hero__size
  name: Media Size
  type: select
  required: false
  description: 'Content size variation: reduced, full, or mini'
  default: full
  options:
    - full
    - reduced
    - mini
  control: select
  labels:
    full: 'Tall'
    reduced: 'Short'
    mini: 'Mini'

withVideo:
  twigProp: grand_hero__video
  name: With Video
  type: boolean
  required: false
  description: Whether to display a video background instead of a static image
  default: false
  control: boolean

width:
  twigProp: grand_hero__width
  name: Banner Width
  type: select
  required: false
  description: 'Banner width: site (contained, with side gutters) or full (edge-to-edge, no gutters)'
  default: site
  options:
    - site
    - full
  control: select
  labels:
    site: 'Contained'
    full: 'Full Width'

videoPlayback:
  twigProp: grand_hero__video_playback
  name: Video Playback
  type: select
  required: false
  description: 'Background video playback: loop (repeats until paused) or once (plays one time and holds on the last frame). Only applies with video.'
  default: loop
  options:
    - loop
    - once
  control: select
  labels:
    loop: 'Loop continuously'
    once: 'Play once and stop'
