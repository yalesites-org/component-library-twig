export default "{#\n # Related Content\n #\n # Renders a heading + an embedded Views render output. Used at the bottom\n # of nodes that have a `field_related_content` reference list, where the\n # block plugin (ys_layouts/related_content_block) hands us:\n #\n #   - related_content__heading  (string)        Editor-set heading.\n #   - related_content__view     (rendered HTML) Pre-rendered Views markup\n #                                               whose rows show content\n #                                               type + linked title.\n #\n # The heading mirrors the visual treatment of the card-collection\n # \"related\" variant (h3 size, semantic h2). View output is inserted\n # verbatim with `|raw` since it arrives as already-rendered HTML — same\n # pattern used by yds-publication-detail / yds-image / yds-video-embed.\n #\n # Available Variables:\n # - related_content__heading     (string)\n # - related_content__heading_id  (string, optional) Override the id placed\n #                                on the <h2> and referenced by\n #                                aria-labelledby on the <section>. Use when\n #                                more than one instance renders on the same\n #                                page. Defaults to `related-content-heading`.\n # - related_content__view        (rendered HTML)\n # - related_content__width       (string)  site (default), or content\n #}\n\n{% include \"@molecules/related-content/_yds-related-content.twig\" with {\n  related_content__heading: related_content__heading,\n  related_content__heading_id: related_content__heading_id,\n  related_content__view: related_content__view,\n  related_content__width: related_content__width|default('site'),\n} %}\n"