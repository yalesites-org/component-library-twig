export default "{% set spacing__base_class = 'cl-table' %}\n\n<div class=\"sb-table-scroll\" role=\"region\" aria-label=\"Spacing tokens\" tabindex=\"0\">\n<table {{ bem(spacing__base_class) }}>\n  <thead>\n    <tr>\n      <th {{ bem('header', [], spacing__base_class) }}>variable</th>\n      <th {{ bem('header', [], spacing__base_class) }}>rem</th>\n      <th {{ bem('header', [], spacing__base_class) }}>px</th>\n      <th {{ bem('header', [], spacing__base_class) }}>example</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for key, value in _context.spacing_options %}\n      <tr>\n        <td>--{{ prefix }}-{{ key }}</td>\n        <td>{{ value|trim('rem') }}</td>\n        <td>{{ value * 16 }}</td>\n        <td><div style=\"background: var(--color-blue-horizon); height: var(--{{ prefix }}-{{key}}); width: var(--{{ prefix }}-{{key}});\"></div></td>\n      </tr>\n    {% endfor %}\n  </tbody>\n</table>\n</div>\n"