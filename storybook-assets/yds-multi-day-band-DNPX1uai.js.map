export default "{#\n # Multi-day band: one strip under a day number, joining the days of a multi-day event.\n # Shown in Compact month and phone days only. It has no text.\n #\n # Available Variables:\n # - multi_day_band__segment: start, middle, end or single. Default middle.\n # - multi_day_band__past: gray band. Default false.\n # - multi_day_band__pointed_at: 8px band while its event is pointed at. Default false.\n #\n # Decorative: the day's accessible label already names the multi-day event.\n # One band per day, never stacked. The parent sets outer margin and width.\n #}\n\n{% set multi_day_band__base_class = 'multi-day-band' %}\n{% set multi_day_band__segment = multi_day_band__segment in ['start', 'middle', 'end', 'single'] ? multi_day_band__segment : 'middle' %}\n{% set multi_day_band__attributes = {\n  'class': bem(multi_day_band__base_class),\n  'aria-hidden': 'true',\n  'data-multi-day-band-segment': multi_day_band__segment,\n} %}\n{% if multi_day_band__past %}\n  {% set multi_day_band__attributes = multi_day_band__attributes|merge({'data-multi-day-band-past': 'true'}) %}\n{% endif %}\n{% if multi_day_band__pointed_at %}\n  {% set multi_day_band__attributes = multi_day_band__attributes|merge({'data-multi-day-band-pointed-at': 'true'}) %}\n{% endif %}\n\n<span {{ add_attributes(multi_day_band__attributes) }}></span>\n"