export default "{% set radii__base_class = \"cl-radii\" %}\n\n<div {{ bem(radii__base_class) }}>\n  <ul {{ bem('list', [], radii__base_class) }}>\n  {% for radius, value in _context.radii %}\n    {% set variable = prefix ~ radius|lower|replace({' ': '-'}) %}\n    {% set radii_item__attributes = {\n      class: bem(\"item\", [], radii__base_class),\n      style: 'border-radius: var(' ~ variable ~ ')',\n      'data-basic-theme': 'gray-700',\n    } %}\n      <li {{ add_attributes(radii_item__attributes) }}>\n        <span {{ bem(\"title\", [], radii__base_class) }}>Radius {{ radius }}</span><br />\n        <details class=\"cl-info\">\n          <summary>Radius Details</summary>\n          <strong>variable:</strong> <code>{{ variable }}</code><br />\n          <strong>value:</strong> {{ value }}\n        </details>\n      </li>\n    {% endfor %}\n  </ul>\n</div>\n"