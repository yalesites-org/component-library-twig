export default "{#\n # Available Props:\n # - site_section_wrap__theme\n # - site_section_wrap__border_thickness\n # - site_section_wrap__nav_position\n #\n # Available Variables\n # - site_name\n #\n # Available Blocks\n # - site_section_wrap__primary_nav\n #}\n\n{% set site_section_wrap__base_class = 'in-this-section' %}\n\n{% set icon_left %}\n  {% include \"@atoms/images/icons/_yds-icon.twig\" with {\n    icon__name: 'angle-down',\n    icon__blockname: site_section_wrap__base_class,\n    icon__modifiers: ['left'],\n    icon__decorative: true,\n  } %}\n{% endset %}\n\n{% set icon_right %}\n  {% include \"@atoms/images/icons/_yds-icon.twig\" with {\n    icon__name: 'angle-down',\n    icon__blockname: site_section_wrap__base_class,\n    icon__modifiers: ['right'],\n    icon__decorative: true,\n  } %}\n{% endset %}\n\n{% set site_section_wrap__attributes = {\n  'data-secondary-menu-state': 'open',\n  'data-component-theme': site_section_wrap__theme|default('one'),\n  'data-in-this-section-overflow': 'hidden',\n  'data-component-width': 'site',\n  class: bem(site_section_wrap__base_class),\n} %}\n\n{% set site_section_inner__attributes = {\n  'class': bem('inner', [], site_section_wrap__base_class),\n  'data-scroll-indicator': 'none',\n} %}\n\n<div {{add_attributes(site_section_wrap__attributes)}}>\n  <div {{add_attributes(site_section_inner__attributes)}}>\n  {% include \"@molecules/menu/menu-in-this-section-toggle/yds-menu-in-this-section-toggle.twig\" %}\n\n    {% block site_section_wrap__primary_nav %}\n      {% include \"@organisms/menu/secondary-nav/yds-secondary-nav.twig\" with {\n        \n      }%}\n    {% endblock %}\n    {% include \"@atoms/controls/base/yds-control.twig\" with {\n      control__content: icon_left,\n      control__base_class: 'control',\n      control__blockname: site_section_wrap__base_class,\n      control__modifiers: ['left'],\n      control__attributes: {\n        'aria-label': 'Show more navigation items',\n      },\n    } %}\n    {% include \"@atoms/controls/base/yds-control.twig\" with {\n      control__content: icon_right,\n      control__base_class: 'control',\n      control__blockname: site_section_wrap__base_class,\n      control__modifiers: ['right'],\n      control__attributes: {\n        'aria-label': 'Show more navigation items',\n      },\n    } %}\n  </div>\n</div>\n"