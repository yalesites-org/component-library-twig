export default "{#\n # Overflow mark: the \"+\" after three event dots when a day has four or more events.\n #\n # Available Variables:\n # - overflow_mark__past: gray mark. Default false.\n #\n # Decorative: the day's accessible label already counts the events.\n # The parent sets outer margin and width; this atom never does.\n #}\n\n{% set overflow_mark__base_class = 'overflow-mark' %}\n{% set overflow_mark__attributes = {\n  'class': bem(overflow_mark__base_class),\n  'aria-hidden': 'true',\n} %}\n{% if overflow_mark__past %}\n  {% set overflow_mark__attributes = overflow_mark__attributes|merge({'data-overflow-mark-past': 'true'}) %}\n{% endif %}\n\n<span {{ add_attributes(overflow_mark__attributes) }}>+</span>\n"