export default "{#\n # Date badge: groups list items by day. A weekday in small caps above the date number.\n # Shown in Compact month with list and the phone day list.\n #\n # Available Variables:\n # - date_badge__weekday: weekday, e.g. \"Tue\", or \"Thu–Sat\" for a range.\n # - date_badge__date: date number, e.g. \"27\", or \"15–17\" for a range.\n # - date_badge__label: full date for screen readers, e.g. \"Tuesday, October 27\".\n # - date_badge__range: true for a date range. Default false.\n # - date_badge__today: solid Yale Blue, white text. Default false.\n # - date_badge__past: Gray 600 fill, white text. Default false.\n #\n # The parent sets outer margin and width; this atom never does.\n #}\n\n{% set date_badge__base_class = 'date-badge' %}\n{% set date_badge__attributes = {\n  'class': bem(date_badge__base_class),\n} %}\n{% if date_badge__range %}\n  {% set date_badge__attributes = date_badge__attributes|merge({'data-date-badge-range': 'true'}) %}\n{% endif %}\n{% if date_badge__today %}\n  {% set date_badge__attributes = date_badge__attributes|merge({'data-date-badge-today': 'true'}) %}\n{% elseif date_badge__past %}\n  {% set date_badge__attributes = date_badge__attributes|merge({'data-date-badge-past': 'true'}) %}\n{% endif %}\n\n<span {{ add_attributes(date_badge__attributes) }}>\n  {% if date_badge__label %}\n    <span {{ bem('label', [], date_badge__base_class) }}>{{ date_badge__label }}</span>\n  {% endif %}\n  <span {{ bem('weekday', [], date_badge__base_class) }}{% if date_badge__label %} aria-hidden=\"true\"{% endif %}>{{ date_badge__weekday }}</span>\n  <span {{ bem('date', [], date_badge__base_class) }}{% if date_badge__label %} aria-hidden=\"true\"{% endif %}>{{ date_badge__date }}</span>\n</span>\n"