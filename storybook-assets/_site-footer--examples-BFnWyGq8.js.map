export default "<div class=\"wrap-for-global-theme\" data-global-theme=\"{{site_global__theme}}\">\n  {% for theme, value in _context.themes %}\n    <section>\n      {% include \"./yds-site-footer.twig\" with {\n        site_footer__theme: theme,\n      } %}\n    </section><br />\n  {% endfor %}\n</div>\n"