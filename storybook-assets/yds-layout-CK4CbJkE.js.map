export default "{#\n # The shared place a YaleSites Layout Builder section's signature is emitted:\n #\n #   <div class=\"yds-layout layout\" data-section-theme=\"X\"\n #        data-component-layout=\"Y\" …>\n #\n # Two Column (70/30), Two Column (30/70), Two Column (50/50) and Three Column\n # (33/33/33) render through here, so adding a new multi-region section type\n # means adding a `component__layout` value and the flex-basis rules for it in\n # `_yds-layout.scss`, and nothing else.\n #\n # **One column does NOT render through here.** atomic's\n # `templates/layouts/layout--onecol.html.twig` hand-rolls the same class and\n # attributes itself, because it needs the wrapper to appear even when the\n # section holds no blocks. So the section signature has TWO emitters and a\n # change to it must be made in both -- missing the second one is precisely the\n # failure mode YaleSites-Internal#1630 was about. Nothing beyond those two\n # should hand-roll these classes or data attributes.\n #\n # Available Variables:\n # - component__theme (string): 'default' by default. The section colour,\n #   emitted as `data-section-theme`. The attribute is deliberately NOT\n #   `data-component-theme`: that one is the BLOCK dial, and it maps a different\n #   set of colour slots (`00-tokens/colors/_color-component-themes.scss` reads\n #   the `component-themes` token layer, `_yds-layout.scss` reads the section\n #   palette). While one attribute carried both meanings, no colour reset could\n #   be correct for both -- see YaleSites-Internal#1630. The PROP keeps its\n #   `component__theme` name so the three `ys_layouts` templates and atomic's\n #   one-column template that set it do not have to change.\n # - component__layout (string): 'fifty-fifty' by default. One of\n #   'one-column', 'seventy-thirty', 'thirty-seventy', 'fifty-fifty',\n #   'thirty-thirty-thirty'. On 'thirty-seventy' the narrow column is\n #   layout__primary (first in source, so it also stacks first on mobile).\n # - layout__divider (string): 'false' by default. The editor's opt-in divider.\n #   Mirrored onto the section root as `data-component-has-divider` for the\n #   layouts that draw their separator in CSS rather than as an element --\n #   'seventy-thirty' and 'thirty-seventy' today. The element-drawing layouts\n #   express the same state by whether `.yds-layout__divider` is in the DOM at\n #   all, so for those the attribute is informational only.\n # - layout__padding (string): 'default' by default.\n # - component__width (string): 'site' by default\n # - layout__extra_classes (array): extra classes for the section element, for\n #   a layout that must keep a class of its own alongside the shared\n #   signature. `layout--onecol` is the one real case: Drupal core's own\n #   stylesheets, and the page's top/bottom margin rules, select on it.\n #\n # Available Blocks:\n # - layout__primary\n # - layout__secondary\n # - layout__tertiary\n #}\n\n{% set layout__base_class = 'yds-layout' %}\n\n{# `.yds-layout__inner` is the flex ROW that lays the regions out side by side.\n # A single-region layout has no row, so it does not get one -- it would make a\n # one-child flex container whose child sizes to its content, and its\n # `> * > * { max-width: 100% }` would stop the full-bleed components a One\n # column section is expected to host from breaking out. #}\n{% set layout__single_region = component__layout == 'one-column' %}\n\n{# seventy-thirty and thirty-seventy draw their column separator as a border\n # on the narrow column, gated on data-component-has-divider (see\n # _yds-layout.scss), so also rendering the divider element would draw the\n # line twice for the same toggle. #}\n{% set layout__show_divider = layout__divider == 'true'\n  and component__layout != 'seventy-thirty'\n  and component__layout != 'thirty-seventy' %}\n\n{% set layout__attributes = {\n  'data-component-has-divider': layout__divider == 'true' ? 'true' : 'false',\n  'data-component-padding': layout__padding|default('default'),\n  'data-section-theme': component__theme|default('default'),\n  'data-component-layout': component__layout|default('fifty-fifty'),\n  'data-component-width': component__width|default('site'),\n  'class': bem(\n    layout__base_class,\n    [],\n    '',\n    ['layout']|merge(layout__extra_classes|default([]))\n  ),\n} %}\n\n<div {{ add_attributes(layout__attributes) }} data-embedded-components>\n  {% if layout__single_region %}\n    {% block layout__primary %}\n      {{ content.primary }}\n    {% endblock %}\n  {% else %}\n    <div {{ bem('inner', [], layout__base_class) }}>\n      <div {{ bem('primary', [], layout__base_class) }}>\n        {# Defined in the single-region branch above; Twig compiles blocks\n         # independently of where they appear, so it is declared once and\n         # rendered from whichever branch runs. #}\n        {{ block('layout__primary') }}\n      </div>\n      {% if layout__show_divider %}\n        <div {{ bem('divider', [], layout__base_class) }}></div>\n      {% endif %}\n      <div {{ bem('secondary', [], layout__base_class) }}>\n        {% block layout__secondary %}\n          {{ content.secondary }}\n        {% endblock %}\n      </div>\n      {% if layout__show_divider and component__layout == 'thirty-thirty-thirty' %}\n        <div {{ bem('divider', [], layout__base_class) }}></div>\n      {% endif %}\n      {% if component__layout == 'thirty-thirty-thirty' %}\n        <div {{ bem('tertiary', [], layout__base_class) }}>\n          {% block layout__tertiary %}\n            {{ content.tertiary }}\n          {% endblock %}\n        </div>\n      {% endif %}\n    </div>\n  {% endif %}\n</div>\n"