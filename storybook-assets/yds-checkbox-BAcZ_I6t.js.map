export default "{% if not attributes %}\n<fieldset class=\"form-item form-item--checkbox\">\n  <legend class=\"h3\">Options as Checkboxes</legend>\n  <ul class=\"form-item--checkboxes\">\n{% endif %}\n  {% for key, checkbox in checkboxes %}\n    {% include \"@atoms/forms/checkbox/_yds-checkbox-item.twig\" with {\n      checkbox_item: checkbox.title,\n      checkbox_item_checked: checkbox.checked,\n    } %}\n  {% endfor %}\n{% if not attributes %}\n  </ul>\n</fieldset>\n{% endif %}\n"