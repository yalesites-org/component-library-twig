export default "<form id=\"contact-form\">\n  <div class=\"form-item\">\n    <label for=\"edit-name\" class=\"form-item__label form-item__label--required form-item__label--textfield\">Name</label>\n    <input id=\"edit-name\" autocorrect=\"none\" autocapitalize=\"none\" spellcheck=\"false\" type=\"text\" name=\"name\" value=\"\" size=\"60\" maxlength=\"60\" class=\"form-item__textfield form-item__textfield--required\" required=\"required\" aria-required=\"true\" placeholder=\"First, Middle, Last\">\n  </div>\n  <div class=\"form-item\">\n    <label for=\"emailaddress\" class=\"form-item__label form-item__label--required form-item__label--textfield\">Email Address</label>\n    <input id=\"emailaddress\" required=\"required\" aria-required=\"true\" type=\"email\" class=\"form-item__textfield form-item__textfield--required\" placeholder=\"name@email.com\">\n  </div>\n  <div class=\"form-item\">\n    <label for=\"emailsubject\" class=\"form-item__label form-item__label--textfield\">Subject</label>\n    <input id=\"emailsubject\" aria-required=\"false\" type=\"email\" class=\"form-item__textfield\" placeholder=\"Your subject here\">\n  </div>\n  <div class=\"form-item\">\n    <label for=\"textarea\" class=\"form-item__label form-item__label--required form-item__label--textfield\">Textarea</label>\n    <textarea id=\"textarea\" required=\"required\" aria-required=\"true\" class=\"form-item__textfield form-item__textarea form-item__textfield--required\"  rows=\"8\" cols=\"48\" placeholder=\"Enter your message here\"></textarea>\n  </div>\n  <div class=\"form-item form-actions\">\n    <input class=\"webform-button--submit button cta button--primary js-form-submit form-submit form-item__textfield\" data-drupal-selector=\"edit-actions-submit\" type=\"submit\" id=\"edit-actions-submit\" name=\"op\" value=\"Send Message\" data-cta-radius=\"none\" data-cta-theme=\"{{ buttonTheme }}\" data-cta-style=\"filled\" data-cta-outline-weight=\"2\" data-cta-hover-style=\"fade\">\n  </div>\n </form>\n"