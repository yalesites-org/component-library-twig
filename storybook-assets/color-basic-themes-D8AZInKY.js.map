export default "{% set color_pairing__base_class = 'cl-basic-themes-pairing' %}\n\n{% for theme, value in _context.themes %}\n  <div {{ bem(color_pairing__base_class) }} data-basic-theme={{ theme }}>\n    <h2>Basic Theme: {{ theme }}</h2>\n    <p class=\"text-field\">Here's a paragraph with some text. And <a href=\"#\">links can go here</a> too. Isn't that cool?</p>\n    <div class=\"cta-group\">\n      {% include \"@atoms/controls/cta/yds-cta.twig\" with {\n        cta__content: 'Cta Link',\n        cta__href: '#',\n      } %}\n      {% include \"@atoms/controls/cta/yds-cta.twig\" with {\n        cta__content: 'Outline',\n        cta__style: 'outline',\n        cta__href: '#',\n      } %}\n    </div>\n    {% include \"@molecules/social-links/yds-social-links.twig\" with {\n      icons: {\n        1: {\n          name: 'Facebook',\n          icon: 'facebook',\n          url: 'https://www.facebook.com',\n        },\n        2: {\n          name: 'X',\n          icon: 'x-twitter',\n          url: 'https://www.twitter.com',\n        }\n      }\n    } %}\n  </div>\n{% endfor %}\n"