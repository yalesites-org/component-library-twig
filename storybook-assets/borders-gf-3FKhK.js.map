export default "{% set borders__base_class = \"cl-borders\" %}\n\n<div {{ bem(borders__base_class) }}>\n  <ul {{ bem('list', [], borders__base_class) }}>\n  {% for border, value in _context.borders %}\n    {% set variable = prefix ~ border|lower|replace({' ': '-'}) %}\n      <li {{ bem(\"item\", [], borders__base_class) }} style=\"border: var({{ variable }}) solid\">\n        <span {{ bem(\"title\", [], borders__base_class) }}>Border {{ border }}</span><br />\n        <details class=\"cl-info\">\n          <summary>Border Details</summary>\n          <strong>variable:</strong> <code>{{ variable }}</code><br />\n          <strong>value:</strong> {{ value }}\n        </details>\n      </li>\n    {% endfor %}\n  </ul>\n</div>\n"