export default "{# Variables are documented in the main `yds-related-content.twig` file. #}\n\n{% set related_content__base_class = 'related-content' %}\n\n{# WCAG 1.3.1 / 4.1.2 — give the <section> an accessible name so it is\n   announced as a region landmark. The wrapper references the heading\n   via aria-labelledby; the heading carries the matching id. Callers can\n   override `related_content__heading_id` to keep ids unique when more\n   than one instance renders on the same page (e.g. visreg stories);\n   the block plugin renders one instance per node so the default is\n   safe in production. #}\n{% set related_content__heading_id = related_content__heading_id|default('related-content-heading') %}\n\n{% set related_content__attributes = {\n  'data-component-width': related_content__width|default('site'),\n  class: bem(related_content__base_class),\n} %}\n\n{% if related_content__heading %}\n  {% set related_content__attributes = related_content__attributes|merge({\n    'aria-labelledby': related_content__heading_id,\n  }) %}\n{% endif %}\n\n{% if related_content__heading or related_content__view %}\n  <section {{ add_attributes(related_content__attributes) }}>\n    <div {{ bem('inner', [], related_content__base_class) }}>\n      {% if related_content__heading %}\n        {# Semantic h2; visual size handled in SCSS to match the card-collection\n           \"related\" treatment (h3 visual). The id wires up aria-labelledby\n           on the surrounding <section> so the region has an accessible name. #}\n        {% include \"@atoms/typography/headings/yds-heading.twig\" with {\n          heading__level: '2',\n          heading__blockname: related_content__base_class,\n          heading: related_content__heading,\n          heading__attributes: {\n            id: related_content__heading_id,\n            class: bem('heading', [], related_content__base_class),\n          },\n        } %}\n      {% endif %}\n\n      {% if related_content__view %}\n        <div {{ bem('list', [], related_content__base_class) }}>\n          {# View output is a pre-rendered HTML string (Views render array\n             converted upstream). Same `|raw` pattern as yds-video-embed and\n             yds-publication-detail — without it, autoescape prints markup\n             as text. #}\n          {{ related_content__view|raw }}\n        </div>\n      {% endif %}\n    </div>\n  </section>\n{% endif %}\n"