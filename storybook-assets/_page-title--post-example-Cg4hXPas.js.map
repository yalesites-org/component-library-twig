export default "{#\n # Storybook-only example of the page header on a post.\n #\n # Mirrors ys_layouts/templates/ys-post-meta-block.html.twig in\n # yalesites-project: content width, byline and date in page_title__meta, and\n # the read-time molecule in the page_title__meta__extra block.\n #\n # Available Variables:\n # - page_title__heading\n # - page_title__meta\n # - page_title__show_social_media_sharing_links\n#}\n\n{% embed \"@molecules/page-title/yds-page-title.twig\" with {\n  page_title__width: 'content',\n} %}\n  {% block page_title__meta__extra %}\n    {% include \"@molecules/read-time/yds-read-time.twig\" with {\n      read_time__label: 'Estimated read time',\n    } %}\n  {% endblock %}\n{% endembed %}\n"