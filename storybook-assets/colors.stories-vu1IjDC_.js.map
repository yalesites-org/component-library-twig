# Print color specifications.
#
# Source: color-specs_2025-05-10.pdf, provided by OPAC (2025-05-10).
#
# `hex` renders the on-screen swatch. On the Core Colors cards it is also shown
# as a value, since those colors are used on web as well as in print. It is NOT
# shown on the accent Print Colors page, which stays print-only: PMS + CMYK, nor
# for `yale_blue` (the Yale Blue card shows its web design-token hex instead).
# For the accent colors the hex is only an approximation of the printed result,
# since Yale's brand colors render differently in print than on screen.
#
# Structure mirrors the print "pyramid" hierarchy:
#   yale_blue  -> sits alone at the top
#   core       -> the blues directly below Yale Blue, plus Warm Gray
#   families   -> the remaining accent colors, in the order Yale publishes them
#                 on the Yale Colors 2025 print reference. The Print Colors page
#                 renders these as one flat grid with no family headings, so the
#                 family keys only set order. To keep the published sequence,
#                 "Gold (dark)" (PMS 131) sits with the oranges and "Orange
#                 (light)" (PMS 7506) sits with the yellows.
#
# Combined coated/uncoated PMS cells (e.g. "PMS 660 C / PMS 279 U") are kept as a
# single string so the C (coated) / U (uncoated) distinction shows as authored.

yale_blue:
  label: 'Yale Blue'
  colors:
    yale-blue:
      name: 'Yale Blue'
      hex: '#00356b'
      pms: 'PMS 648 C / PMS 295 U'
      cmyk_coated: '100, 75, 8, 40'
      cmyk_uncoated: '100, 75, 5, 35'

core:
  label: 'Core Colors'
  colors:
    blue:
      name: 'Blue'
      hex: '#4681C2'
      pms: 'PMS 660 C / PMS 279 U'
      cmyk_coated: '74, 44, 0, 0'
      cmyk_uncoated: '70, 39, 0, 0'
    blue-light:
      name: 'Blue (light)'
      hex: '#78A7D8'
      pms: 'PMS 645'
      cmyk_coated: '51, 23, 0, 1'
      cmyk_uncoated: '52, 24, 0, 1'
    blue-lighter:
      name: 'Blue (lighter)'
      hex: '#A7CFEE'
      pms: 'PMS 277'
      cmyk_coated: '32, 8, 0, 0'
      cmyk_uncoated: '31, 8, 0, 0'
    warm-gray:
      name: 'Warm Gray'
      hex: '#968B83'
      pms: 'PMS Warm Gray 7'
      cmyk_coated: '43, 41, 45, 4'
      cmyk_uncoated: '33, 31, 33, 17'

