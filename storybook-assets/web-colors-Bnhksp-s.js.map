export default "{% set colors__base_class = \"cl-colors\" %}\n{% set card_name_level = 'h3' %}\n\n{# -------------------------------------------------------------------------\n   Yale Blue\n   When section == 'yale-blue' or no section set (full page)\n   ------------------------------------------------------------------------- #}\n{% if not section or section == 'yale-blue' %}\n  <div {{ bem(colors__base_class) }}>\n    <ul {{ bem('list', [], colors__base_class) }}>\n      {% for key, color in print_colors.yale_blue.colors %}\n        <li {{ bem('item', ['featured'], colors__base_class) }}>\n          <div {{ bem('swatch', [], colors__base_class) }} style=\"background: {{ yale_blue_web.hex ?? color.hex }};\"></div>\n          <div {{ bem('info', [], colors__base_class) }}>\n            <{{ card_name_level }} {{ bem('name', [], colors__base_class) }}>{{ color.name }}</{{ card_name_level }}>\n\n            {# Web hex from design token #}\n            {% if yale_blue_web %}\n              <div {{ bem('value-row', [], colors__base_class, ['text-copy-button']) }}>\n                <span {{ bem('label', [], colors__base_class) }}>HEX</span>\n                <code class=\"cl-colors__value pre-text__text\">{{ yale_blue_web.hex }}</code>\n                <button class=\"cl-colors__copy-btn text-copy-button__button\" type=\"button\">\n                  <svg class=\"cl-colors__icon-copy\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                    <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                  </svg>\n                  <svg class=\"cl-colors__icon-check\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <polyline points=\"20 6 9 17 4 12\"></polyline>\n                  </svg>\n                  <span {{ bem('copy-label', [], colors__base_class) }}>Copy HEX {{ yale_blue_web.hex }}</span>\n                </button>\n              </div>\n            {% endif %}\n\n            {# Print values — PMS + CMYK. \"PMS \" is stripped from the value since\n               the row is already labelled \"PMS\", so a combined coated/uncoated\n               cell reads \"648 C / 295 U\" rather than \"PMS 648 C / PMS 295 U\". #}\n            {% set print_rows = {\n              'PMS': color.pms|replace({'PMS ': ''}),\n              'CMYK (Coated)': color.cmyk_coated,\n              'CMYK (Uncoated)': color.cmyk_uncoated\n            } %}\n            {% for label, val in print_rows %}\n              <div {{ bem('value-row', [], colors__base_class, ['text-copy-button']) }}>\n                <span {{ bem('label', [], colors__base_class) }}>{{ label }}</span>\n                <code class=\"cl-colors__value pre-text__text\">{{ val }}</code>\n                <button class=\"cl-colors__copy-btn text-copy-button__button\" type=\"button\">\n                  <svg class=\"cl-colors__icon-copy\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                    <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                  </svg>\n                  <svg class=\"cl-colors__icon-check\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <polyline points=\"20 6 9 17 4 12\"></polyline>\n                  </svg>\n                  <span {{ bem('copy-label', [], colors__base_class) }}>Copy {{ label }} {{ val }}</span>\n                </button>\n              </div>\n            {% endfor %}\n          </div>\n        </li>\n      {% endfor %}\n    </ul>\n  </div>\n{% endif %}\n\n{# -------------------------------------------------------------------------\n   Core Colors\n   When section == 'core' or no section set (full page)\n   ------------------------------------------------------------------------- #}\n{% if not section or section == 'core' %}\n  <div {{ bem(colors__base_class) }}>\n    <ul {{ bem('list', [], colors__base_class) }}>\n      {% for key, color in print_colors.core.colors %}\n        <li {{ bem('item', [], colors__base_class) }}>\n          <div {{ bem('swatch', [], colors__base_class) }} style=\"background: {{ color.hex }};\"></div>\n          <div {{ bem('info', [], colors__base_class) }}>\n            {# No card name — the values below identify the card. #}\n\n            {# Hex — core colors are used on web as well as in print #}\n            <div {{ bem('value-row', [], colors__base_class, ['text-copy-button']) }}>\n              <span {{ bem('label', [], colors__base_class) }}>HEX</span>\n              <code class=\"cl-colors__value pre-text__text\">{{ color.hex }}</code>\n              <button class=\"cl-colors__copy-btn text-copy-button__button\" type=\"button\">\n                <svg class=\"cl-colors__icon-copy\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                  <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                  <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                </svg>\n                <svg class=\"cl-colors__icon-check\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                  <polyline points=\"20 6 9 17 4 12\"></polyline>\n                </svg>\n                <span {{ bem('copy-label', [], colors__base_class) }}>Copy HEX {{ color.hex }}</span>\n              </button>\n            </div>\n\n            {# Print values — PMS + CMYK, same specs as Yale Blue. \"PMS \" is\n               stripped from the value since the row is already labelled \"PMS\". #}\n            {% set print_rows = {\n              'PMS': color.pms|replace({'PMS ': ''}),\n              'CMYK (Coated)': color.cmyk_coated,\n              'CMYK (Uncoated)': color.cmyk_uncoated\n            } %}\n            {% for label, val in print_rows %}\n              <div {{ bem('value-row', [], colors__base_class, ['text-copy-button']) }}>\n                <span {{ bem('label', [], colors__base_class) }}>{{ label }}</span>\n                <code class=\"cl-colors__value pre-text__text\">{{ val }}</code>\n                <button class=\"cl-colors__copy-btn text-copy-button__button\" type=\"button\">\n                  <svg class=\"cl-colors__icon-copy\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                    <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                  </svg>\n                  <svg class=\"cl-colors__icon-check\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <polyline points=\"20 6 9 17 4 12\"></polyline>\n                  </svg>\n                  <span {{ bem('copy-label', [], colors__base_class) }}>Copy {{ label }} {{ val }}</span>\n                </button>\n              </div>\n            {% endfor %}\n          </div>\n        </li>\n      {% endfor %}\n    </ul>\n  </div>\n{% endif %}\n\n{# -------------------------------------------------------------------------\n   Accent Colors for Print — PMS + CMYK, no hex displayed\n   When section == 'accent-print' or no section set (full page)\n\n   Families (Red, Yellow, Green, ...) are flattened into a single grid with no\n   per-family headings, so the page stays short enough to embed comfortably.\n   ------------------------------------------------------------------------- #}\n{% if not section or section == 'accent-print' %}\n  <div {{ bem(colors__base_class) }}>\n    <ul {{ bem('list', [], colors__base_class) }}>\n      {% for family_key, family in print_colors.families %}\n        {% for key, color in family.colors %}\n          <li {{ bem('item', [], colors__base_class) }}>\n            <div {{ bem('swatch', [], colors__base_class) }} style=\"background: {{ color.hex }};\"></div>\n            <div {{ bem('info', [], colors__base_class) }}>\n              {# No card name — the PMS value below acts as the card's identifier.\n                 \"PMS \" is stripped from the value since the row is already\n                 labelled \"PMS\". #}\n              {% set print_rows = {\n                'PMS': color.pms|replace({'PMS ': ''}),\n                'CMYK (Coated)': color.cmyk_coated,\n                'CMYK (Uncoated)': color.cmyk_uncoated\n              } %}\n              {% for label, val in print_rows %}\n                <div {{ bem('value-row', [], colors__base_class, ['text-copy-button']) }}>\n                  <span {{ bem('label', [], colors__base_class) }}>{{ label }}</span>\n                  <code class=\"cl-colors__value pre-text__text\">{{ val }}</code>\n                  <button class=\"cl-colors__copy-btn text-copy-button__button\" type=\"button\">\n                    <svg class=\"cl-colors__icon-copy\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                      <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                      <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                    </svg>\n                    <svg class=\"cl-colors__icon-check\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                      <polyline points=\"20 6 9 17 4 12\"></polyline>\n                    </svg>\n                    <span {{ bem('copy-label', [], colors__base_class) }}>Copy {{ label }} {{ val }}</span>\n                  </button>\n                </div>\n              {% endfor %}\n            </div>\n          </li>\n        {% endfor %}\n      {% endfor %}\n    </ul>\n  </div>\n{% endif %}\n\n{# -------------------------------------------------------------------------\n   Accent Colors for Web — HEX values from design tokens\n   When section == 'accent-web' or no section set (full page)\n\n   Groups (Cyan, Green, Yellow, ...) are flattened into a single grid with no\n   per-group headings, so the page stays short enough to embed comfortably.\n   ------------------------------------------------------------------------- #}\n{% if not section or section == 'accent-web' %}\n  <div {{ bem(colors__base_class) }}>\n    <ul {{ bem('list', [], colors__base_class) }}>\n      {% for group, colorset in _context.colors %}\n        {% for key, color in colorset %}\n          <li {{ bem('item', [], colors__base_class) }}>\n            <div {{ bem('swatch', [], colors__base_class) }} style=\"background: var({{ color.css_var }});\"></div>\n            <div {{ bem('info', [], colors__base_class) }}>\n              <span {{ bem('var', [], colors__base_class) }}>{{ color.css_var }}</span>\n              <div {{ bem('value-row', [], colors__base_class, ['text-copy-button']) }}>\n                <span {{ bem('label', [], colors__base_class) }}>HEX</span>\n                <code class=\"cl-colors__value pre-text__text\">{{ color.hex }}</code>\n                <button class=\"cl-colors__copy-btn text-copy-button__button\" type=\"button\">\n                  <svg class=\"cl-colors__icon-copy\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\" ry=\"2\"></rect>\n                    <path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>\n                  </svg>\n                  <svg class=\"cl-colors__icon-check\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <polyline points=\"20 6 9 17 4 12\"></polyline>\n                  </svg>\n                  <span {{ bem('copy-label', [], colors__base_class) }}>Copy HEX {{ color.hex }}</span>\n                </button>\n              </div>\n            </div>\n          </li>\n        {% endfor %}\n      {% endfor %}\n    </ul>\n  </div>\n{% endif %}\n"