export default "{% set secondary_menu_toggle__base_class = 'secondary-menu-toggle' %}\n\n{% set menu_toggle__content %}\n  {% include \"@atoms/images/icons/_yds-icon.twig\" with {\n    icon__name: 'circle-chevron-solid',\n    icon__modifiers: secondary_menu_toggle__icon__modifiers,\n    icon__blockname: secondary_menu_toggle__icon__blockname|default(secondary_menu_toggle__base_class),\n  } %}\n  <span {{ bem('text', [], secondary_menu_toggle__base_class) }}>{{ secondary_menu_toggle__text|default('In This Section') }}</span>\n{% endset %}\n\n{% include \"@atoms/controls/base/yds-control.twig\" with {\n  control__base_class: secondary_menu_toggle__base_class,\n  control__blockname: secondary_menu_toggle__blockname,\n  aria_expanded: secondary_menu_toggle__aria_expanded|default('false'),\n  control__content: menu_toggle__content\n} %}\n"