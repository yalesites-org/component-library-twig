# layout-props.yml
#
# Layout component property definitions.
# This file is the single source of truth for both Storybook controls
# and MDX documentation tables.

divider:
  twigProp: layout__divider
  name: Divider
  type: boolean
  required: false
  description: Show a visual divider between layout regions
  detail: >
    When true, displays a visual divider between layout content regions. Passed
    to Twig as the string 'true' or 'false' via layout__divider, and mirrored
    onto the section root as data-component-has-divider. Has no effect on
    'one-column' -- a single region has nothing to divide. 'seventy-thirty'
    and 'thirty-seventy' honour it like the other multi-column layouts, but
    draw their separator as a border on the narrow column gated on that data
    attribute, rather than as a .yds-layout__divider element: rendering both
    for one section drew the line twice.
  default: false
  control: boolean

layoutOption:
  twigProp: component__layout
  name: Layout
  type: select
  required: false
  description: Column configuration for the layout
  detail: >
    Selects the section layout. This is the only thing that differs between the
    five YaleSites Layout Builder sections. Four of them render through this
    one component, which emits the shared signature
    `<div class="yds-layout layout" data-section-theme data-component-layout>`;
    One column hand-rolls the same signature in atomic's
    `templates/layouts/layout--onecol.html.twig`, because it needs the wrapper
    to render even when the section holds no blocks. Keep the two in step.
    Adding a new section type means adding a value here and its flex-basis
    rules in _yds-layout.scss, not a new template; that is how 'thirty-seventy'
    (a 70/30 with the narrow column first, as __primary) was added.
    'one-column' is a single region, so it renders its content directly in the
    section element rather than inside the __inner flex row and a __primary
    column.
  default: fifty-fifty
  options:
    - one-column
    - fifty-fifty
    - thirty-thirty-thirty
    - seventy-thirty
    - thirty-seventy
  control: select
  labels:
    one-column: 'One column'
    fifty-fifty: 'Two column (50/50)'
    thirty-thirty-thirty: 'Three column (33/33/33)'
    seventy-thirty: 'Two column (70/30)'
    thirty-seventy: 'Two column (30/70)'

layoutPadding:
  twigProp: layout__padding
  name: Section Padding Options
  type: select
  required: false
  description: Vertical padding configuration for the layout component
  default: default
  options:
    Default: default
    No top padding: no-top
    No bottom padding: no-bottom
    No padding (top and bottom): no-padding
  control: select

theme:
  twigProp: component__theme
  name: Section Theme
  type: select
  required: false
  description: >
    Color theme applied to the section, emitted as `data-section-theme`. Not the
    same dial as a block's `data-component-theme` -- the two map different color
    slots (YaleSites-Internal#1630). The prop keeps its `component__theme` name
    because it is public API that ys_layouts and atomic set.
  default: default
  options:
    - default
    - one
    - two
    - three
    - four
    - five
    - six
  control: select
  labels:
    default: 'Default - No Color'
    one: 'One'
    two: 'Two'
    three: 'Three'
    four: 'Four'
    five: 'Five'
    six: 'Six'
