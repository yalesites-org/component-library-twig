export default "{% if not attributes %}\n<div class=\"form-item\">\n  <label for=\"select\" class=\"h4\">Select Dropdown</label>\n  <div class=\"form-item__dropdown\">\n    <select class=\"form-item__select\" id=\"select\">\n      <optgroup label=\"Whatever\">\n{% endif %}\n        {% for selection in select %}\n          {% include \"@atoms/forms/select/_yds-select-item.twig\" with {\n            select_item: selection.title\n          } %}\n        {% endfor %}\n{% if not attributes %}\n      </optgroup>\n    </select>\n  </div>\n</div>\n{% endif %}\n"