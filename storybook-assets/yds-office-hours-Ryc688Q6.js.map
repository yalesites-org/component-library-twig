export default "{#\n # Office Hours: a weekly schedule table, an optional \"Upcoming changes\" table\n # and a live Open now / Closed now status.\n #\n # Available Variables:\n # - office_hours__heading: optional visible title.\n # - office_hours__heading_level: heading level for the title (default 2).\n # - office_hours__name: what the hours belong to, used in the table captions.\n # - office_hours__days: weekly rows, in display order. Each row:\n #     - label: the day name, e.g. 'Tuesday'.\n #     - weekday: 0 (Sunday) to 6. Lets the status script find today.\n #     - today: TRUE to mark the row as today on first paint.\n #     - closed: TRUE when the day is marked Closed.\n #     - all_day: TRUE when the day is open around the clock.\n #     - slots: list of {start, end}, 24-hour HHMM integers (1000, 1730).\n #     - comment: optional note shown under the hours.\n #     - exception: TRUE when this date's hours replace the usual ones; the\n #       comment is then the exception's label.\n #     - date: ISO date (Y-m-d) of an exception row. Dated rows are re-picked\n #       by the script on load, so a cached page still shows the right week.\n #     - hidden: TRUE to render the row hidden (an exception outside this\n #       week, or a weekday row an exception replaces).\n # - office_hours__upcoming: later exceptions, same row shape, with the date as\n #     the label.\n # - office_hours__status: show the Open now / Closed now line (default TRUE).\n #     It is computed by yds-office-hours.js and stays hidden without it.\n # - office_hours__timezone: IANA time zone the hours are in. The status is\n #     computed in this zone, not the visitor's.\n # - office_hours__empty_message: shown when there are no rows at all. Leave\n #     unset to render nothing in that case.\n #}\n\n{% import _self as office_hours %}\n\n{#\n # Formats a 24-hour HHMM integer as '10 a.m.' / '5:30 p.m.'. Pass\n # with_meridiem FALSE for the first half of a same-half range ('2–8 p.m.').\n #}\n{% macro time(value, with_meridiem) -%}\n  {%- set hour = (value / 100)|round(0, 'floor') % 24 -%}\n  {%- set minute = value % 100 -%}\n  {{- hour % 12 == 0 ? 12 : hour % 12 -}}\n  {{- minute ? ':' ~ (minute < 10 ? '0' ~ minute : minute) -}}\n  {{- with_meridiem ? (hour < 12 ? ' a.m.' : ' p.m.') -}}\n{%- endmacro %}\n\n{% macro range(slot) -%}\n  {%- import _self as office_hours -%}\n  {%- set start_pm = ((slot.start / 100)|round(0, 'floor') % 24) >= 12 -%}\n  {%- set end_pm = ((slot.end / 100)|round(0, 'floor') % 24) >= 12 -%}\n  {{- office_hours.time(slot.start, start_pm != end_pm) -}}–{{- office_hours.time(slot.end, true) -}}\n{%- endmacro %}\n\n{# The day's hours as one machine-readable string for the status script. #}\n{% macro data_hours(row) -%}\n  {%- if row.all_day -%}\n    all-day\n  {%- elseif not row.closed -%}\n    {%- for slot in row.slots|default([]) -%}\n      {{- slot.start }}-{{ slot.end }}{{ not loop.last ? ',' -}}\n    {%- endfor -%}\n  {%- endif -%}\n{%- endmacro %}\n\n{% set office_hours__base_class = 'office-hours' %}\n{% set office_hours__days = office_hours__days|default([]) %}\n{% set office_hours__upcoming = office_hours__upcoming|default([]) %}\n{% set office_hours__name = office_hours__name|default(office_hours__heading|default('Hours')) %}\n\n{% if office_hours__days or office_hours__upcoming %}\n  {# data-component-width gives the block the site gutter in a one-column\n   # section, like Text and Accordion; inside a column layout the layout's\n   # data-embedded-components switches that padding off. The inner wrapper\n   # is centered at the site width by the shared `__inner` rule. #}\n  <div {{ bem(office_hours__base_class) }} data-component-width=\"site\" data-component-theme=\"{{ office_hours__theme|default('default') }}\"{% if office_hours__timezone %} data-office-hours-timezone=\"{{ office_hours__timezone }}\"{% endif %}>\n    <div {{ bem('inner', [], office_hours__base_class) }}>\n      {% if office_hours__heading %}\n        <h{{ office_hours__heading_level|default(2) }} {{ bem('heading', [], office_hours__base_class) }}>{{ office_hours__heading }}</h{{ office_hours__heading_level|default(2) }}>\n      {% endif %}\n\n      {% if office_hours__status is not defined or office_hours__status %}\n        {# Hidden until the script computes it, so there is never a wrong status\n         # on first paint, and never one at all without JavaScript. #}\n        <div {{ bem('status', [], office_hours__base_class) }} role=\"status\" hidden>\n          <span {{ bem('pill', [], office_hours__base_class) }}>\n            <svg {{ bem('icon', ['open'], office_hours__base_class) }} viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"8\" cy=\"8\" r=\"8\" fill=\"currentColor\"/><path d=\"M4.6 8.3l2.3 2.3 4.5-4.7\" fill=\"none\" stroke=\"var(--office-hours-fg)\" stroke-width=\"1.8\" stroke-linecap=\"square\"/></svg>\n            <svg {{ bem('icon', ['closed'], office_hours__base_class) }} viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"8\" cy=\"8\" r=\"6.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M4.8 8h6.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>\n            <span {{ bem('pill-label', [], office_hours__base_class) }}></span>\n          </span>\n          <span {{ bem('status-detail', [], office_hours__base_class) }}></span>\n        </div>\n      {% endif %}\n\n      {% if office_hours__days %}\n        {# Explicit roles keep the table semantics when the narrow layout sets\n         # display: block, which Safari and older Chrome otherwise drop. #}\n        <table {{ bem('table', [], office_hours__base_class) }} role=\"table\">\n          <caption {{ bem('caption', [], office_hours__base_class) }}>Weekly hours for {{ office_hours__name }}</caption>\n          <thead {{ bem('head', [], office_hours__base_class) }} role=\"rowgroup\">\n            <tr role=\"row\">\n              <th {{ bem('col', ['day'], office_hours__base_class) }} scope=\"col\" role=\"columnheader\">Day</th>\n              <th {{ bem('col', ['hours'], office_hours__base_class) }} scope=\"col\" role=\"columnheader\">Hours</th>\n            </tr>\n          </thead>\n          <tbody role=\"rowgroup\">\n            {% for row in office_hours__days %}\n              <tr {{ bem('row', row.today ? ['today'] : [], office_hours__base_class) }} role=\"row\"{% if row.weekday is defined and row.weekday is not same as(null) %} data-weekday=\"{{ row.weekday }}\"{% endif %} data-hours=\"{{ office_hours.data_hours(row) }}\"{% if row.date %} data-date=\"{{ row.date }}\"{% endif %}{% if row.exception %} data-exception=\"{{ row.comment }}\"{% endif %}{% if row.hidden %} hidden{% endif %}>\n                <th {{ bem('day', [], office_hours__base_class) }} scope=\"row\" role=\"rowheader\"{% if row.today %} aria-current=\"date\"{% endif %}>\n                  <span {{ bem('day-name', [], office_hours__base_class) }}>{{ row.label }}</span>\n                  {% if row.today %}\n                    <span {{ bem('today', [], office_hours__base_class) }}>Today</span>\n                  {% endif %}\n                </th>\n                <td {{ bem('hours', [], office_hours__base_class) }} role=\"cell\">\n                  {% if row.all_day %}\n                    <div {{ bem('slot', [], office_hours__base_class) }}>Open all day</div>\n                  {% elseif row.closed or not row.slots %}\n                    <div {{ bem('slot', [], office_hours__base_class) }}>Closed</div>\n                  {% else %}\n                    {% for slot in row.slots %}\n                      <div {{ bem('slot', [], office_hours__base_class) }}>{{ office_hours.range(slot) }}</div>\n                    {% endfor %}\n                  {% endif %}\n                  {% if row.comment or row.exception %}\n                    <div {{ bem('note', [], office_hours__base_class) }}>\n                      {% if row.exception %}\n                        <span {{ bem('tag', [], office_hours__base_class) }}>Exception</span>\n                      {% endif %}\n                      {{ row.comment }}\n                    </div>\n                  {% endif %}\n                </td>\n              </tr>\n            {% endfor %}\n          </tbody>\n        </table>\n      {% endif %}\n\n      {% if office_hours__upcoming %}\n        {# Rows can arrive hidden: the script re-picks the next three on load. #}\n        {% set office_hours__upcoming_shown = false %}\n        {% for row in office_hours__upcoming %}\n          {% set office_hours__upcoming_shown = office_hours__upcoming_shown or not row.hidden %}\n        {% endfor %}\n        <h{{ office_hours__heading_level|default(2) + 1 }} {{ bem('upcoming-heading', [], office_hours__base_class) }}{{ office_hours__upcoming_shown ? '' : ' hidden' }}>Upcoming changes</h{{ office_hours__heading_level|default(2) + 1 }}>\n        <table {{ bem('table', ['upcoming'], office_hours__base_class) }} role=\"table\"{{ office_hours__upcoming_shown ? '' : ' hidden' }}>\n          <caption {{ bem('caption', [], office_hours__base_class) }}>Upcoming schedule changes for {{ office_hours__name }}</caption>\n          <tbody role=\"rowgroup\">\n            {% for row in office_hours__upcoming %}\n              <tr {{ bem('row', [], office_hours__base_class) }} role=\"row\"{% if row.date %} data-date=\"{{ row.date }}\"{% endif %}{% if row.hidden %} hidden{% endif %}>\n                <th {{ bem('day', [], office_hours__base_class) }} scope=\"row\" role=\"rowheader\">\n                  <span {{ bem('day-name', [], office_hours__base_class) }}>{{ row.label }}</span>\n                </th>\n                <td {{ bem('hours', [], office_hours__base_class) }} role=\"cell\">\n                  <div {{ bem('slot', [], office_hours__base_class) }}>\n                    {%- if row.all_day -%}\n                      Open all day\n                    {%- elseif row.closed or not row.slots -%}\n                      Closed\n                    {%- else -%}\n                      {%- for slot in row.slots -%}\n                        {{ office_hours.range(slot) }}{{ not loop.last ? ', ' }}\n                      {%- endfor -%}\n                    {%- endif -%}\n                    {{- row.comment ? ' · ' ~ row.comment -}}\n                  </div>\n                </td>\n              </tr>\n            {% endfor %}\n          </tbody>\n        </table>\n      {% endif %}\n    </div>\n  </div>\n{% elseif office_hours__empty_message %}\n  {# Same wrapper as a filled block so the placeholder sits on its gutter. #}\n  <div {{ bem(office_hours__base_class) }} data-component-width=\"site\">\n    <div {{ bem('inner', [], office_hours__base_class) }}>\n      <p {{ bem('empty', [], office_hours__base_class) }}>{{ office_hours__empty_message }}</p>\n    </div>\n  </div>\n{% endif %}\n"