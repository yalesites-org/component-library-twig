# image-banner-props.yml
#
# Image Banner component property definitions.
# This file is the single source of truth for both Storybook controls
# and MDX documentation tables.

size:
  twigProp: image_banner__size
  name: Media Size
  type: select
  required: false
  description: 'Image height variation: tall, short, or mini'
  default: tall
  options:
    - tall
    - short
    - mini
  control: select
  labels:
    tall: 'Tall'
    short: 'Short'
    mini: 'Mini'

withVideo:
  twigProp: image_banner__video
  name: With Video
  type: boolean
  required: false
  description: Whether to display a video background instead of a static image
  default: false
  control: boolean

imageCaption:
  twigProp: image_banner__caption
  name: Image Caption
  type: string
  required: false
  description: Caption text displayed below or over the image
  control: text

width:
  twigProp: image_banner__width
  name: Banner Width
  type: select
  required: false
  description: 'Banner width: site (contained, with side gutters) or full (edge-to-edge, no gutters)'
  default: site
  options:
    - site
    - full
  control: select
  labels:
    site: 'Contained'
    full: 'Full Width'
