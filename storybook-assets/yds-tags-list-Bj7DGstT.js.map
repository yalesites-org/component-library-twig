export default "{# A <ul> with no <li> is what SiteImprove reports as \"Container element is empty\". #}\n{% if items is not empty %}\n  <ul {{ bem('taxonomy-list', ['tags'], '') }}>\n    {% for item in items %}\n      <li {{ bem('item', [], 'taxonomy-list') }}>\n        {% block list_item %}\n          {{ item.content }}\n        {% endblock %}\n      </li>\n      <li aria-hidden=\"true\" {{ bem('divider', [], 'taxonomy-list') }}>{{ '|' }}</li>\n    {% endfor %}\n  </ul>\n{% endif %}\n"