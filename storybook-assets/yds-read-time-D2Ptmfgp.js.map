export default "{#\n # Available Variables:\n # - icons (array)\n #   - \n #}\n\n{% set read_time__base_class = 'read-time' %}\n\n{% set read_time__attributes = {\n  'class': bem(read_time__base_class),\n} %}\n\n<div {{ add_attributes(read_time__attributes) }}>\n  <div {{ bem('inner', [], read_time__base_class) }}>\n    <span {{ bem('label', [], read_time__base_class) }}>{{read_time__label|default('Estimated read time')}}:</span>\n    <span {{ bem('time', [], read_time__base_class) }} id=\"read_time\">0</span>\n    <span {{ bem('time__minutes', [], read_time__base_class) }}id=\"read_time_min\">min</span>\n  </div>\n</div>\n"