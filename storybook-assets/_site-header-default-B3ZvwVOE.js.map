export default "{# Secondary should come first on \"desktop\" sized screens #}\n<div {{ bem('menu-secondary', ['desktop'], site_header__base_class) }}>\n  {% include \"@organisms/site-header/_site-header--secondary.twig\" with {\n    screen_size: 'desktop',\n  }%}\n</div>\n  {{ site_header__primary }}\n{# Secondary should come second on \"mobile\" sized screens #}\n<div {{ bem('menu-secondary', ['mobile'], site_header__base_class) }}>\n  {% include \"@organisms/site-header/_site-header--secondary.twig\" with {\n    screen_size: 'mobile',\n  }%}\n</div>\n"