export default "{% set breakpoints__base_class = 'cl-table' %}\n{% set breakpoint_names = {\n  's': 'Small',\n  'm': 'Medium',\n  'l': 'Large',\n  'xl': 'X-Large',\n  '2xl': 'XX-Large',\n  'max-width': 'Max-Width',\n  'mobile': 'Mobile (targets larger screens)',\n  'mobile-max': 'Mobile Max (targets smaller screens)',\n} %}\n\n<div class=\"sb-table-scroll\" role=\"region\" aria-label=\"Breakpoint tokens\" tabindex=\"0\">\n<table {{ bem(breakpoints__base_class) }}>\n  <thead>\n    <tr>\n      <th {{ bem('header', [], breakpoints__base_class) }}>Breakpoint</th>\n      <th {{ bem('header', [], breakpoints__base_class) }}>(SCSS) Variable</th>\n      <th {{ bem('header', [], breakpoints__base_class) }}>Width</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for breakpoint, value in _context.breakpoints %}\n      <tr>\n        {% for breakpoint_short, breakpoint_name in breakpoint_names %}\n          {% if breakpoint_short == breakpoint %}\n            <td>{{ breakpoint_name }}</td>\n          {% endif %}\n        {% endfor %}\n        <td>$break-{{ breakpoint }}</td>\n        <td>{{ value }}</td>\n      </tr>\n    {% endfor %}\n  </tbody>\n</table>\n</div>\n"