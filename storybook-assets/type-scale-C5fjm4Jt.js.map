export default "{% set type__base_class = 'cl-type' %}\n\n<ul {{ bem(type__base_class) }}>\n  {% for key, value in font_scale %}\n    <li {{ bem('item', [], type__base_class) }}>\n      <div {{ bem('sample', [], type__base_class) }} style=\"font-size: {{ value }}; font-family: var(--font-families-mallory-compact);\">\n        The quick brown fox jumps over the lazy dog.\n      </div>\n      <div class=\"cl-info\">\n        <code>--font-scale-{{ key }}</code>\n      </div>\n    </li>\n  {% endfor %}\n</ul>\n"