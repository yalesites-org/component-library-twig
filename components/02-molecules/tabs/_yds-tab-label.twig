<li {{ bem('item', [], tabs__base_class) }} role="presentation">
  {% set tabs__link__attributes = {
    'class': bem('link', [], tabs__base_class),
    'role': 'tab',
    'aria-controls': 'tab-' ~ tabs__id ~ '-' ~ key,
    'href': '#tab-' ~ tabs__id ~ '-' ~ key,
  } %}
  {# Only the selected tab is a Tab stop; the arrow keys reach the others.
   # These stay literal markup: printed as a Twig string, Drupal escapes the
   # quotes and browsers ignore the value. #}
  <a {{ add_attributes(tabs__link__attributes) }}{% if key == 0 %} aria-selected="true"{% else %} tabindex="-1"{% endif %}>
    {{ tab__label|default(tab.tab__label) }}
  </a>
</li>
