{#
 # Available Variables:
 # - embed__src
 # - embed__title
 # - embed__width: default('site')
 # - embed__type: 'form', 'audio', default('form')
 # - embed__loading: 'lazy', 'eager', default('lazy')
 # - embed__allowfullscreen: TRUE, FALSE, default(FALSE)
 # - embed__klaro_service: a Klaro consent service (app) id, default(null).
 #     When set, the iframe ships `data-src` instead of `src` so the
 #     third-party request is held until the visitor consents. Klaro keys off
 #     `data-name` to restore the `src` on consent, and meanwhile inserts its
 #     click-to-load placeholder as a sibling immediately before the iframe.
 #     Only the iframe carries `data-name`: Klaro places a placeholder before
 #     every matching element, so tagging the wrapper too would build a second,
 #     hidden one.
 #}

{% set embed__base_class = 'embed' %}
{% set embed__width = embed__width|default('site') %}
{% set embed__type = embed__type|default('form') %}
{% set embed__loading = embed__loading|default('lazy') %}
{% set embed__allowfullscreen = embed__allowfullscreen|default(FALSE) %}
{% set embed__klaro_service = embed__klaro_service|default(null) %}

{% set embed__attributes = {
  'data-component-width': embed__width,
  'class': bem(embed__base_class),
} %}

<div {{ add_attributes(embed__attributes) }}>
  {% block prefix_suffix %}
  {% endblock %}
  <div {{ bem('inner', [], embed__base_class) }}>
    {% block embed__block %}
      {# Chrome and Firefox block clipboard writes inside a cross-origin iframe
       # unless `allow` delegates the permission. See embed.mdx. #}
      {# One iframe, with only the source attributes switching: a second copy
       # could drift and lose `allow`, which embed-iframe-allow.test.mjs pins. #}
      <iframe {{ bem('iframe', [], embed__base_class) }} title="{{ embed__title }}" {% if embed__klaro_service %}data-src="{{ embed__src }}" data-name="{{ embed__klaro_service }}"{% else %}src="{{ embed__src }}"{% endif %} height="100%" width="100%" loading="{{ embed__loading }}" allow="clipboard-write" allowfullscreen="{{ embed__allowfullscreen }}" data-embed-type="{{ embed__type }}">
      </iframe>
    {% endblock %}
  </div>
</div>
